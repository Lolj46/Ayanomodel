
name: Build Ayanokoji Playermodel

on:
  workflow_dispatch:
  push:
    paths:
      - "ayanokoji_gmod_source_build.zip"
      - ".github/workflows/build-playermodel.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-22.04
    timeout-minutes: 60

    steps:
      - name: Checkout model project
        uses: actions/checkout@v4

      - name: Checkout Source SDK
        uses: actions/checkout@v4
        with:
          repository: ValveSoftware/source-sdk-2013
          ref: c3ca7291626b60a32008774dd290671708babc20
          path: source-sdk-2013

      - name: Checkout studiomdl build kit
        uses: actions/checkout@v4
        with:
          repository: MSteam/studiomdl-linux
          ref: 5d22a9c5c398345e16b0deb4d8003495ef365cd6
          path: studiomdl-linux

      - name: Install tools
        run: |
          sudo apt-get update
          sudo apt-get install -y unzip zip

      - name: Extract model archive
        run: |
          set -euo pipefail
          unzip -q ayanokoji_gmod_source_build.zip -d "$RUNNER_TEMP/model"
          find "$RUNNER_TEMP/model" -maxdepth 4 -type f
          test -d "$RUNNER_TEMP/model/ayanokoji_playermodel"
          echo "MODEL=$RUNNER_TEMP/model/ayanokoji_playermodel" >> "$GITHUB_ENV"

      - name: Build studiomdl
        run: |
          set -euo pipefail
          SDK="$GITHUB_WORKSPACE/source-sdk-2013/sp"
          mkdir -p "$SDK/game/bin"
          docker pull registry.gitlab.steamos.cloud/steamrt/scout/sdk
          cd studiomdl-linux
          ./scripts/check_deps.sh "$SDK"
          ./scripts/apply_to_sdk.sh "$SDK"
          ./scripts/build.sh "$SDK"
          test -x "$SDK/game/bin/studiomdl"
          echo "STUDIOMDL=$SDK/game/bin/studiomdl" >> "$GITHUB_ENV"

      - name: Inspect model sources
        run: |
          set -euo pipefail
          find "$MODEL" -type f
          find "$MODEL" -iname "*.qc" -o -iname "*.smd"

      - name: Compile model
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/game/models" "$RUNNER_TEMP/game/materials"
          cp -a "$MODEL/materials/." "$RUNNER_TEMP/game/materials/"
          cd "$MODEL/modelsrc"
          "$STUDIOMDL" -game "$RUNNER_TEMP/game" -nop4 ayanokoji.qc 2>&1 | tee "$RUNNER_TEMP/compile.log"

      - name: Upload build logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ayanokoji-build-logs
          path: ${{ runner.temp }}/compile.log
          if-no-files-found: ignore

      - name: Upload compiled files
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: ayanokoji-compiled-model
          path: ${{ runner.temp }}/game/models/
          if-no-files-found: error
